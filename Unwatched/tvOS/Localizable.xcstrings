    "videosUnavailableDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Videos anzusehen, öffne Unwatched auf deinem iOS/iPadOS-Gerät und füge Videos zu deiner Warteschlange hinzu.\n\nStelle sicher, dass die iCloud-Synchronisation aktiviert ist (unter Bibliothek → Einstellungen → Benutzerdaten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To see videos, open Unwatched on your iOS/iPadOS device and add Videos to your Queue.  Make sure you have iCloud sync enabled (under Library → Settings → User Data)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ver videos, abre Unwatched en tu dispositivo iOS/iPadOS y añade Videos a tu Cola. \n\nAsegúrate de tener la sincronización de iCloud activada (en Biblioteca → Ajustes → Datos de usuario)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour voir les vidéos, ouvrez Unwatched sur votre appareil iOS/iPadOS et ajoutez des vidéos à votre file d'attente.\n\nAssurez-vous d'avoir activé la synchronisation iCloud (dans Bibliothèque → Paramètres → Données utilisateur)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zobaczyć filmy otwórz Unwatched na swoim urządzeniu iOS/iPadOS i dodaj filmy do kolejki.\n\nUpewnij się, że synchronizacja iCloud jest włączona (Biblioteka → Ustawienia → Dane użytkownika)."
          }
        }
      }
    },
