    "watchFullSyncDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erste Synchronisierung kann langsam sein, läuft danach aber komplett unabhängig. Kann im Hintergrund laufen, während Telefon-Synchronisierung aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Initial sync may be slow, but fully independent once caught up. Can run in the background while Phone Sync is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización inicial puede ser lenta, pero funciona de forma totalmente independiente una vez completada. Puede ejecutarse en segundo plano mientras la sincronización con el teléfono está activada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation initiale peut être lente, mais devient totalement autonome une fois terminée. Peut s'exécuter en arrière-plan pendant que la synchronisation avec le téléphone est activée."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstępna synchronizacja może być wolna, ale po jej zakończeniu działa całkowicie niezależnie. Może działać w tle, gdy synchronizacja z telefonem jest włączona."
          }
        }
      }
    },
